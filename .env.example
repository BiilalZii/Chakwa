APP_ENV=development
SECRET_KEY=غيّر-هذه-القيمة-إلى-مفتاح-طويل-وعشوائي
DATABASE_URL=sqlite:///complaints.db

# بريد تجريبي فقط، ويجب استبداله ببريد رسمي معتمد
PILOT_SUPERVISOR_EMAIL=
ARCHIVE_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.dz

# العنوان الذي سيحوّله QR إليه
PUBLIC_BASE_URL=http://127.0.0.1:5000

# أنشئ كلمة المرور المشفرة بالأمر الموضح في README
ADMIN_PASSWORD_HASH=

# في الإنتاج يُفضّل استخدام Redis بدل الذاكرة المحلية
RATELIMIT_STORAGE_URI=memory://

# مدة الاحتفاظ بالبلاغات بالأيام قبل أرشفتها/حذفها عبر أمر retention-cleanup
RETENTION_DAYS=730

# أقصى عدد لمحاولات إرسال البريد قبل اعتبار الرسالة فاشلة
NOTIFICATION_MAX_ATTEMPTS=5

# قفل دخول الإدارة مؤقتًا بعد عدد محاولات فاشلة
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
